# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Transactional email (FR-024). Leave blank locally: in-app notifications still work and
# email sending is skipped rather than failing.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@amanah.example
